# =============================================================================
# Docker Compose Environment
# Скопируй в .env и заполни реальными значениями: cp .env.example .env
# =============================================================================

# --- MySQL ---
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=secrets
MYSQL_ROOT_PASSWORD=rootpassword

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- API ---
APP_DEBUG=1
APP_ENV=local

# --- Bybit ---
BYBIT_TESTNET_BASE_URL=https://api-testnet.bybit.com
BYBIT_MAINNET_BASE_URL=https://api.bybit.com

# =============================================================================
# Production / Deploy (для make build, make push, make deploy)
# =============================================================================

# --- Docker Registry ---
REGISTRY=ghcr.io/rebit-pro
IMAGE_TAG=latest

# --- Docker Registry Auth (для docker login на сервере) ---
REGISTRY_HOST=ghcr.io
REGISTRY_USER=
TOKEN_GIT_HUB=

# --- Deploy Target ---
HOST=
PORT=22
DEPLOY_USER=deploy
BUILD_NUMBER=

# --- Swarm ---
STACK_NAME=site

# --- Frontend Build ---
VITE_API_URL=https://api.rebit-pro.ru
