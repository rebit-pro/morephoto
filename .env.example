# =============================================================================
# Docker Compose Environment
# Скопируй в .env и заполни реальными значениями: cp .env.example .env
# =============================================================================

# --- MySQL ---
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=secrets
MYSQL_ROOT_PASSWORD=rootpassword

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- API ---
APP_DEBUG=1
APP_ENV=local
REBIT_TOKEN_TTL_HOURS=24
REBIT_AUTH_REGISTRATION_CODE_TTL_MINUTES=15
REBIT_AUTH_REGISTRATION_RESEND_COOLDOWN_SECONDS=60
REBIT_AUTH_REGISTRATION_MAX_ATTEMPTS=5
REBIT_AUTH_MAIL_EVENT_SITE_ID=s1
REBIT_SMTP_HOST=mailpit
REBIT_SMTP_PORT=1025
REBIT_SMTP_ENCRYPTION=none
REBIT_SMTP_USERNAME=
REBIT_SMTP_PASSWORD=
REBIT_SMTP_FROM_EMAIL=noreply@rebit-p2p.loc
REBIT_SMTP_FROM_NAME="Rebit P2P"
REBIT_SMTP_TLS_CERTCHECK=off

# Приём заявок с сайта (POST /api/v1/lead) → Telegram
# Локально — токен здесь; в production токен берётся из Docker Swarm secret
# rebit_telegram_bot_token (см. deploy/secrets/README.md), а остальное — из backend.env.
REBIT_NOTIFICATION_TELEGRAM_BOT_TOKEN=
REBIT_NOTIFICATION_TELEGRAM_CHAT_ID=
REBIT_NOTIFICATION_TELEGRAM_API_URL=https://api.telegram.org
# Прокси для запроса в Telegram (api.telegram.org заблокирован с сервера).
# Поддерживается любой формат cURL: socks5h://user:pass@host:port или http://user:pass@host:port
REBIT_NOTIFICATION_TELEGRAM_PROXY=
# Максимальный размер файла ТЗ к заявке, МБ (дефолт 15). Должен быть не больше
# PHP upload_max_filesize/post_max_size. Telegram sendDocument держит до 50 МБ.
REBIT_NOTIFICATION_LEAD_MAX_FILE_MB=15
# CORS/preflight для /api/v1/lead обрабатывает nginx (origin https://rebit-pro.ru
# добавлен в docker/common/nginx/conf.d/map.conf).

# Охота за лидами (rebit.leadhunter): мониторинг внешних площадок → Telegram.
# Правила — JSON: source (площадка), params (параметры ленты), keywords
# (пустой список = брать весь раздел). Для fl.ru раздел «Сайты под ключ» =
# category=2, subcategory=27. Токен/прокси Telegram общие (REBIT_NOTIFICATION_*).
REBIT_LEADHUNTER_RULES='[{"source":"flRu","keywords":["битрикс","bitrix"]},{"source":"flRu","params":{"category":2,"subcategory":27},"keywords":[]}]'
# Чат по умолчанию общий с заявками с сайта (REBIT_NOTIFICATION_TELEGRAM_CHAT_ID);
# отдельный чат — раскомментировать:
#REBIT_LEADHUNTER_TELEGRAM_CHAT_ID=
# Переопределение URL ленты fl.ru (для тестов/зеркала):
#REBIT_LEADHUNTER_FLRU_RSS_URL=https://www.fl.ru/rss/all.xml
# Резервная доставка письмом, когда Telegram недоступен (уходит на последней
# из 5 попыток отправки). Пусто = резерв выключен:
#REBIT_LEADHUNTER_FALLBACK_EMAIL=
REBIT_GEETEST_ENABLED=0
REBIT_GEETEST_BYPASS=1
REBIT_GEETEST_CAPTCHA_ID=
REBIT_GEETEST_CAPTCHA_KEY=
REBIT_GEETEST_API_URL=https://gcaptcha4.geetest.com

# --- Bybit ---
BYBIT_TESTNET_BASE_URL=https://api-testnet.bybit.com
BYBIT_MAINNET_BASE_URL=https://api.bybit.com

# --- RabbitMQ ---
RABBITMQ_USER=rebit
RABBITMQ_PASSWORD=rebit
RABBITMQ_VHOST=rebit
RABBITMQ_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_EXTERNAL_PORT=15672
# Dev: пароль напрямую. Production: использовать __RABBITMQ_PASSWORD__ — подставится из Docker secret.
MESSENGER_TRANSPORT_DSN=amqp://rebit:rebit@rabbitmq:5672/rebit

# --- Local Docker / Traefik ---
TRAEFIK_CERT_PATH=/home/user/traefik/certs/rebit-p2p.loc.pem

# =============================================================================
# Production / Deploy (для make build, make push, make deploy)
# =============================================================================

# --- Docker Registry ---
REGISTRY=ghcr.io/rebit-pro
IMAGE_TAG=latest

# --- Docker Registry Auth (для docker login на сервере) ---
REGISTRY_HOST=ghcr.io
REGISTRY_USER=
TOKEN_GIT_HUB=

# --- Deploy Target ---
HOST=
PORT=22
DEPLOY_USER=deploy
BUILD_NUMBER=

# --- Swarm ---
STACK_NAME=site

# --- Frontend Build ---
VITE_API_URL=https://api.rebit-pro.ru
VITE_GEETEST_CAPTCHA_ID=
