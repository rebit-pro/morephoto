parameters:
    level: 6
    tmpDir: var/phpstan
    paths:
        - public/local/modules
    excludePaths:
        - public/local/modules/*/vendor
    ignoreErrors:
        # Bitrix специфичные ошибки
        - '#Call to an undefined method [a-zA-Z0-9\\_]+::GetList\(\)#'
        - '#Call to an undefined method [a-zA-Z0-9\\_]+::fetch\(\)#'
        - '#Undefined variable: \$_SESSION#'
        - '#Class [a-zA-Z0-9\\_]+Table not found#'
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    reportUnmatchedIgnoredErrors: false
